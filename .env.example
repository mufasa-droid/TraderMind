# ==============================================================================
# TRADERMIND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# Note: For public portfolio demo mode, NEXT_PUBLIC_DEMO_MODE=true is pre-enabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTHENTICATION & STORAGE)
# ------------------------------------------------------------------------------
# Connect your Supabase project (https://supabase.com).
# Safe in browser:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only (NEVER prefix with NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. AI BEHAVIORAL COACHING ENGINES
# ------------------------------------------------------------------------------
# Layer 2 Behavioral Intelligence Engine.
# Provide at least one API key (Gemini or OpenAI). The system automatically falls
# back to OpenAI if Gemini is unavailable, or vice-versa.
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------------------------
# 4. PORTFOLIO & HACKATHON DEMO MODE
# ------------------------------------------------------------------------------
# When true, enables guest bypass, pre-fills demo account credentials on /auth/login,
# and activates calibrated demo performance datasets.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_USER_EMAIL=demo@tradermind.io
NEXT_PUBLIC_DEMO_USER_PASSWORD=TraderMind2026!

# ------------------------------------------------------------------------------
# 5. BROKER SYNC & LIVE INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# MetaTrader 4 / MetaTrader 5 Cloud Bridge (MetaApi.cloud)
META_API_TOKEN=

# Binance API (Read-only Spot/Futures credentials)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Bybit API (Read-only credentials)
BYBIT_API_KEY=
BYBIT_API_SECRET=
